# systemd USER unit (no root needed). Installed to ~/.config/systemd/user/ by install.sh.
# Starts at boot without a login because lingering is enabled: `loginctl show-user $USER -p Linger`.
[Unit]
Description=Lush AI Music Studio worker (render node)
After=network-online.target acestep-api.service
Wants=network-online.target

[Service]
WorkingDirectory=%h/lush-worker
EnvironmentFile=%h/.config/lush/worker.env
ExecStart=%h/lush-worker/.venv/bin/python -m lush_worker
# SIGTERM lets the worker hand its job back to the queue before exiting.
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
