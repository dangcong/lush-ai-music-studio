# Lush AI Music Studio - worker configuration.
# Copy to `.env` (read from the current working directory) or export as environment variables.
# Real environment variables take precedence over this file.

# --- Control Plane (required) ---
CONTROL_PLANE_URL=http://localhost:8080
NODE_TOKEN=paste-the-node-token-shown-once-by-admin

# --- Engines ---
# Comma separated: mock | acestep | mock,acestep
WORKER_ENGINES=mock

# --- ACE-Step 1.5 (only used when WORKER_ENGINES contains "acestep") ---
ACESTEP_URL=http://127.0.0.1:8001
ACESTEP_API_KEY=
# Max seconds to wait for one generation task.
ACESTEP_TIMEOUT=1800
# Directory on this node holding LoRA adapters, one sub-directory per LoRA key:
#   <LORA_DIR>/<key>/adapter_config.json + adapter_model.safetensors
LORA_DIR=

# --- Misc ---
# Scratch directory for per-job files (default: <system temp>/lush-worker).
WORK_DIR=
# Seconds to sleep per fake diffusion step of the mock engine.
MOCK_STEP_DELAY=0.3
LOG_LEVEL=INFO
