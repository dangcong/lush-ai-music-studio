# Replace studio.example.com with the real domain and 100.x.y.z with the VPS's Tailscale IP
# (`tailscale ip -4`). Caddy obtains and renews HTTPS certificates itself.

# Public website: employees. The worker protocol is NOT reachable here.
studio.example.com {
	encode zstd gzip

	@worker path /api/worker/*
	respond @worker "forbidden" 403

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	# React single-page app.
	handle {
		root * /opt/lush/current/web
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
	}
}

# Private listener: render nodes only, bound to the Tailscale interface.
# Traffic is already encrypted by WireGuard, so plain HTTP is used inside the tunnel.
# Workers set CONTROL_PLANE_URL=http://100.x.y.z:8081
http://100.x.y.z:8081 {
	bind 100.x.y.z

	@notworker not path /api/worker/* /api/health
	respond @notworker "forbidden" 403

	request_body {
		max_size 600MB
	}
	reverse_proxy 127.0.0.1:8080
}
