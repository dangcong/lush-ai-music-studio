# Lush API (control plane). Copy to .env and adjust. Never commit .env.

BIND_ADDR=127.0.0.1:8080
# Database and uploaded artifacts live under DATA_DIR. DATABASE_URL defaults to sqlite://<DATA_DIR>/lush.db
DATA_DIR=data
# DATABASE_URL=sqlite:///var/lib/lush/lush.db

# Serve the built React app from the API (optional; leave empty when a reverse proxy serves it)
WEB_DIST=

# Set to true behind HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false
SESSION_HOURS=168

# First admin, created only when the users table is empty. Remove after the first start.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Worker protocol tuning
JOB_LEASE_SECONDS=90
HEARTBEAT_INTERVAL_SECONDS=15
WORKER_POLL_INTERVAL_SECONDS=3
NODE_ONLINE_SECONDS=45
MAX_UPLOAD_MB=512

# Logging, e.g. info,tower_http=debug
# RUST_LOG=info
