[Unit]
Description=Lush AI Music Studio API (control plane)
After=network-online.target
Wants=network-online.target

[Service]
User=lush
Group=lush
WorkingDirectory=/opt/lush/current
EnvironmentFile=/etc/lush/api.env
ExecStart=/opt/lush/current/lush-api
Restart=always
RestartSec=3

# Hardening: the service only needs its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/lush

[Install]
WantedBy=multi-user.target
